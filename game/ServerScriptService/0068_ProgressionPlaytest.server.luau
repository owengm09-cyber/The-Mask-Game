if not game:GetService("RunService"):IsStudio() then return end
task.wait(3)
local P=require(script.Parent.ProgressionService)
local p=game.Players:GetPlayers()[1] or game.Players.PlayerAdded:Wait()
repeat task.wait(.1) until p:GetAttribute("ProgressionLoaded") and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
local reports={}
local function check(v,msg) assert(v,msg) table.insert(reports,msg) end
local ok,err=xpcall(function()
workspace.MaskSystem:SetAttribute("CreatureEnabled",false)
P.Begin({p})
check(not P.Task(p,"a"),"Lobby task rejected")
p:SetAttribute("InRound",true)
check(P.InnocentsAlive()==1,"Living innocent counted")
check(P.Task(p,"a"),"Round task accepted")
check(not P.Task(p,"a"),"Repeated task rejected")
P.Tick(300)
check(P.Finish("Innocents"),"Round reward processed")
check(not P.Finish("Innocents"),"Repeated round finish rejected")
task.wait(1)
check(p:GetAttribute("TotalXP")==215,"215 XP awarded")
check(p:GetAttribute("Level")==2 and p:GetAttribute("LevelXP")==115,"Level and remaining XP replicated")
P.Begin({p}) P.MarkMonster(p)
check(P.InnocentsAlive()==0,"Monster excluded from innocent victory count")
check(not P.Task(p,"b"),"Monster cannot farm innocent tasks")
P.Finish("Monster") task.wait(1)
check(p:GetAttribute("TotalXP")==365 and p:GetAttribute("Level")==3,"Second round accumulates XP and levels")
check(p.leaderstats.Wins.Value==2,"Wins persist between rounds")
p:SetAttribute("InRound",false)
end,debug.traceback)
P.Finish(nil)
local result=Instance.new("StringValue",game.ServerStorage) result.Name="ProgressionTestResults" result.Value=(ok and "PASS" or "FAIL").."\n"..table.concat(reports,"\n").."\n"..tostring(err or "")
